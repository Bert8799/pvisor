 /// - `GET /path/to/blob` to read the blob
 ///
 /// The http proxy server should respect [the `Range` header](https://www.rfc-editor.org/rfc/rfc9110.html#name-range) to support range reading.
+// One backend owns one gate. A permit covers the complete response body, not
+// just connection/header establishment. Zero preserves existing callers.
+struct RequestGate {
+    active: std::sync::Mutex<usize>,
+    available: std::sync::Condvar,
+    limit: usize,
+    timeout: std::time::Duration,
+}
+struct RequestPermit(Arc<RequestGate>);
+impl Drop for RequestPermit {
+    fn drop(&mut self) {
+        *self.0.active.lock().unwrap() -= 1;
+        self.0.available.notify_one();
+    }
+}
+impl RequestGate {
+    fn acquire(self: &Arc<Self>) -> Result<Option<RequestPermit>> {
+        if self.limit == 0 {
+            return Ok(None);
+        }
+        let deadline = std::time::Instant::now() + self.timeout;
+        let mut active = self.active.lock().unwrap();
+        while *active == self.limit {
+            let left = deadline.saturating_duration_since(std::time::Instant::now());
+            if left.is_zero() {
+                return Err(Error::new(
+                    std::io::ErrorKind::TimedOut,
+                    "HTTP concurrency limit",
+                ));
+            }
+            active = self.available.wait_timeout(active, left).unwrap().0;
+        }
+        *active += 1;
+        Ok(Some(RequestPermit(self.clone())))
+    }
+}
+
