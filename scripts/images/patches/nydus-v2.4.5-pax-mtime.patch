+    #[test]
+    fn test_pax_mtime_exact_nanoseconds() {
+        assert_eq!(
+            super::parse_pax_mtime(b"1700000000.123456789").unwrap(),
+            (1700000000, 123456789)
+        );
+        assert_eq!(super::parse_pax_mtime(b"0.000000001").unwrap(), (0, 1));
+        assert_eq!(super::parse_pax_mtime(b"42.1").unwrap(), (42, 100000000));
+        assert_eq!(super::parse_pax_mtime(b"42").unwrap(), (42, 0));
+        assert_eq!(
+            super::parse_pax_mtime(b"42.123456789000").unwrap(),
+            (42, 123456789)
+        );
+        for invalid in [
+            "-1.5",
+            "1.0000000001",
+            "NaN",
+            "1e9",
+            "1.a",
+            "18446744073709551616",
+        ] {
+            assert!(
+                super::parse_pax_mtime(invalid.as_bytes()).is_err(),
+                "{invalid}"
+            );
+        }
+    }
